<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/course_widget_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/course_widget_course_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">
    <TextView
        android:id="@+id/course_widget_time"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/course_widget_accent"
        android:textSize="12sp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/course_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/course_widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/course_widget_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/course_widget_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
