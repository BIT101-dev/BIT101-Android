<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/course_widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/course_widget_day_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/course_widget_day"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/course_widget_chip_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/course_widget_today"
                android:textColor="@color/course_widget_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/course_widget_summary"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:text="@string/course_widget_loading"
                android:textColor="@color/course_widget_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/course_widget_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/course_widget_refresh"
            android:padding="5dp"
            android:src="@drawable/course_widget_refresh" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">
        <GridView
            android:id="@+id/course_widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="8dp"
            android:numColumns="1"
            android:padding="0dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="8dp" />
        <TextView
            android:id="@+id/course_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/course_widget_loading"
            android:textColor="@color/course_widget_secondary"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
