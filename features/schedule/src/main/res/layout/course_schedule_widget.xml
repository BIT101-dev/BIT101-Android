<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/course_widget_background"
    android:orientation="vertical"
    android:padding="8dp">
    <include layout="@layout/course_widget_header" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/course_widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:scrollbars="none" />
        <TextView
            android:id="@+id/course_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/course_widget_loading"
            android:textColor="@color/course_widget_secondary"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
