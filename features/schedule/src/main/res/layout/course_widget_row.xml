<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/course_widget_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/course_widget_course_background"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:padding="8dp">
    <TextView
        android:id="@+id/course_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/course_widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/course_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/course_widget_secondary"
        android:textSize="11sp" />
</LinearLayout>
